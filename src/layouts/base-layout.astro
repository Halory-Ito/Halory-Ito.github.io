---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../features/layout/site-header.astro';
import SiteFooter from '../features/layout/site-footer.astro';
import MaskControl from '../features/layout/mask-control.astro';
import { layout, maskControl, site } from '../config';

interface Props {
  title?: string;
  /** 标题界面 / 阅读场景有各自的 chrome，设为 false 关闭公共 Header/Footer */
  showHeader?: boolean;
  showFooter?: boolean;
  /** 全局蒙层悬浮按钮；标题界面与阅读页（有自己的 BG 面板）关闭 */
  showMaskControl?: boolean;
}

const { title = site.name, showHeader = true, showFooter = true, showMaskControl = true } = Astro.props;
const { autoHide, topTriggerPx, bottomHideZonePx, pageTransition: pt } = layout;

/**
 * 页面级过渡动画描述（Astro View Transitions 的原始动画对象形式）：
 * fade = 交叉淡出（与 Astro 内置根过渡相同 keyframes：plus-lighter 混合），
 * slide = 旧页滑出 / 新页滑入，none 直接交给简写字符串。时长与缓动来自 config.layout.pageTransition。
 */
const stepsFor = () =>
  pt.kind === 'fade'
    ? {
        old: { name: 'astroFadeOut', duration: pt.duration, easing: pt.easing, fillMode: 'both' },
        new: { name: 'astroFadeIn', duration: pt.duration, easing: pt.easing, fillMode: 'both' }
      }
    : {
        old: [
          { name: 'astroFadeOut', duration: pt.duration, easing: pt.easing, fillMode: 'both' },
          { name: 'astroSlideToLeft', duration: pt.duration, easing: pt.easing, fillMode: 'both' }
        ],
        new: [
          { name: 'astroFadeIn', duration: pt.duration, easing: pt.easing, fillMode: 'both' },
          { name: 'astroSlideFromRight', duration: pt.duration, easing: pt.easing, fillMode: 'both' }
        ]
      };
const pageAnim =
  pt.kind === 'none'
    ? 'none'
    : { forwards: stepsFor(), backwards: stepsFor() };
import '../styles/global.css';
---

<html lang="zh-CN" transition:animate={pageAnim}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={site.description} />
    <title>{title}</title>
    {
      /* 蒙层偏好写成 html 上的 CSS 变量，而不是往 <style> 里注入覆盖规则。
         注入规则在换页时会被 head 合并拆掉，textContent 重写还会让浏览器丢掉样式一帧；
         View Transitions 正好在这一帧拍下新页快照，淡入动画就把错误的透明度/模糊放出来。
         变量在首屏脚本和 before-swap 里写到新文档的 html 上，swap 时随属性一并拷过来，
         新页蒙层第一帧就继承到正确值。 */
    }
    <script
      is:inline
      define:vars={{
        maskKey: maskControl.storageKey,
        opacityMin: maskControl.opacityMin,
        opacityMax: maskControl.opacityMax,
        blurMin: maskControl.blurMin,
        blurMax: maskControl.blurMax
      }}
    >
      (() => {
        const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
        const readPrefs = () => {
          try {
            const raw = localStorage.getItem(maskKey);
            if (!raw) return null;
            const parsed = JSON.parse(raw);
            const opacity = Number(parsed.opacity);
            const blur = Number(parsed.blur);
            if (!Number.isFinite(opacity) || !Number.isFinite(blur)) return null;
            return {
              opacity: clamp(opacity, opacityMin, opacityMax),
              blur: clamp(blur, blurMin, blurMax)
            };
          } catch {
            return null;
          }
        };
        const percent = (value) => `${Math.round(value * 10000) / 100}%`;
        const backdrop = (blur) => (blur > 0 ? `blur(${blur}px)` : 'none');
        /* 与 mask-style.ts 的 maskBlurScale 同一公式：1 + blur / 160 */
        const blurScale = (blur) => (blur > 0 ? String(Math.round((1 + blur / 160) * 1000) / 1000) : null);
        const setVar = (root, name, value) => {
          if (value == null) {
            if (root.style.getPropertyValue(name)) root.style.removeProperty(name);
            return;
          }
          if (root.style.getPropertyValue(name) !== value) root.style.setProperty(name, value);
        };
        const apply = (doc) => {
          const root = (doc || document).documentElement;
          if (!root) return;
          const prefs = readPrefs();
          const opacity = prefs ? percent(prefs.opacity) : null;
          const blur = prefs ? backdrop(prefs.blur) : null;
          const scale = prefs ? blurScale(prefs.blur) : null;
          /* swap 只拷贝 html 属性，不读 CSSOM。新文档必须把变量写进 style 属性。 */
          if (doc && doc !== document) {
            const parts = [];
            if (opacity) parts.push(`--vn-mask-opacity:${opacity}`);
            if (blur) parts.push(`--vn-mask-backdrop:${blur}`);
            if (scale) parts.push(`--vn-mask-bg-scale:${scale}`);
            if (parts.length) root.setAttribute('style', parts.join(';'));
            else root.removeAttribute('style');
            return;
          }
          setVar(root, '--vn-mask-opacity', opacity);
          setVar(root, '--vn-mask-backdrop', blur);
          setVar(root, '--vn-mask-bg-scale', scale);
        };
        if (!window.__vnblogMaskStyles) {
          window.__vnblogMaskStyles = apply;
          document.addEventListener('astro:before-swap', (event) => apply(event.newDocument));

          /* 背景图要在新页快照之前解码完，否则过渡拍到的是纯色底。
             before-preparation 的 loader 可以包一层，等新文档里的背景图解码后再开始过渡。 */
          const decodeImage = (url) =>
            new Promise((resolve) => {
              const image = new Image();
              image.onload = () => (image.decode ? image.decode().catch(() => {}).finally(resolve) : resolve());
              image.onerror = resolve;
              image.src = url;
            });
          const preloadBackgrounds = async (event) => {
            try {
              const urls = [...event.newDocument.querySelectorAll('img[data-vn-mask-bg]')]
                .map((image) => image.getAttribute('src'))
                .filter(Boolean)
                .map((src) => new URL(src, event.to).href);
              if (!urls.length) return;
              await Promise.race([
                Promise.all([...new Set(urls)].map(decodeImage)),
                new Promise((resolve) => setTimeout(resolve, 1200))
              ]);
            } catch {
              /* 预加载失败不阻断导航，最多回到旧行为 */
            }
          };
          document.addEventListener('astro:before-preparation', (event) => {
            const load = event.loader;
            event.loader = async () => {
              await load();
              await preloadBackgrounds(event);
            };
          });
        }
        apply();
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body
    class="bg-night-950 text-noon"
    data-top-trigger={String(topTriggerPx)}
    data-bottom-zone={String(bottomHideZonePx)}
  >
    {showHeader && <SiteHeader />}
    <slot />
    {showFooter && <SiteFooter />}
    {showMaskControl && <MaskControl />}

    {
      /* 鼠标移向屏幕边缘唤出公共 chrome；触发距离均来自 config.layout。
         View Transitions 会替换 body 节点，因此监听器以“事件发生时实时查询 DOM”实现，
         只需注册一次（window 级监听跨页面导航持续有效），并去重防止脚本重复执行时重复注册。 */
      (showHeader || showFooter) && autoHide && (
        <script>
          (function () {
            const win = window as typeof window & { __vnblogChromeMove?: (e: MouseEvent) => void };
            const onMove = (e: MouseEvent) => {
              const header = document.querySelector('[data-chrome="top"]');
              const footer = document.querySelector('[data-chrome="bottom"]');
              const topTrigger = Number(document.body.getAttribute('data-top-trigger')) || 64;
              const bottomZone = Number(document.body.getAttribute('data-bottom-zone')) || 36;
              if (header) {
                header.classList.toggle('-translate-y-full', e.clientY > topTrigger);
              }
              if (footer) {
                footer.classList.toggle('translate-y-full', e.clientY <= window.innerHeight - bottomZone);
              }
            };
            if (win.__vnblogChromeMove) return;
            win.__vnblogChromeMove = onMove;
            window.addEventListener('mousemove', onMove);
          })();
        </script>
      )
    }
  </body>
</html>
