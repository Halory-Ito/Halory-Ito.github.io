---
import { render } from 'astro:content';
import { fallbackCoverFor } from '../post/lib';
import { taxonomyHref } from '../post/taxonomy';
import { article, routes, site, theme } from '../../config';
import { maskAttrs, maskStyle } from '../theme/mask-style';
import { Image } from 'astro:assets';
import { ArrowLeft, ArrowRight } from 'lucide-react';
import BaseLayout from '../../layouts/base-layout.astro';
import '../../styles/global.css';

interface Props {
  post: import('../post/lib').PostEntry;
  prev: import('../post/lib').PostEntry | null;
  next: import('../post/lib').PostEntry | null;
}

const { post, prev, next } = Astro.props;
/** 官方 Content Collections 渲染：remark/rehype + 内置 Shiki 高亮 + Markdown 图片管线 */
const { Content } = await render(post);
const cover = post.data.cover ?? fallbackCoverFor(post.id);
const coverDims = theme.imageDefaults.background;
const readHref = `${routes.read}${post.id}`;
---

<BaseLayout title={`${site.name} | ${post.data.title}`}>
  <div class="relative min-h-dvh bg-[#15122d]">
    <!-- 背景与视口对齐（fixed），不随文章高度拉伸 -->
    <div class="fixed inset-0">
      <Image
        src={cover}
        alt="文章背景"
        width={coverDims.width}
        height={coverDims.height}
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0" {...maskAttrs('page')} style={maskStyle(theme.masks.page)}></div>
    </div>

    <main class="relative z-10 mx-auto max-w-6xl px-6 pb-24">
      <!-- Layout 公共 Header 之外的文章上下文入口 -->
      <div class="flex items-center justify-end px-1 pt-6">
        <a class="inline-flex items-center gap-2 text-xs tracking-[0.4em] text-white/60 uppercase transition-colors hover:text-white" href={readHref}>
          <span>{article.advLabel}</span>
          <ArrowRight className="h-4 w-4" strokeWidth={1.5} />
        </a>
      </div>

      <section class="relative mt-2 overflow-hidden rounded-2xl">
        <Image
          src={cover}
          alt="文章头图"
          width={coverDims.width}
          height={coverDims.height}
          class="h-72 w-full object-cover sm:h-96"
        />
        <div class="absolute inset-0" {...maskAttrs('cover')} style={maskStyle(theme.masks.cover)}></div>
        <div class="absolute inset-x-0 bottom-0 p-8 sm:p-12">
          <div class="flex flex-wrap items-center gap-3 text-[0.7rem] tracking-[0.35em] text-white/60 uppercase">
            <a
              class="rounded-full bg-[rgba(15,12,34,0.45)] px-3 py-0.5 transition-colors hover:bg-[rgba(196,190,255,0.15)] hover:text-white"
              href={taxonomyHref('category', post.data.category)}
            >
              {post.data.category}
            </a>
            {
              post.data.tags.map((tag) => (
                <a
                  class="transition-colors hover:text-white"
                  href={taxonomyHref('tag', tag)}
                >
                  {tag}
                </a>
              ))
            }
          </div>
          <h1 class="mt-4 text-4xl tracking-[0.2em] sm:text-5xl">{post.data.title}</h1>
          <p class="mt-3 text-[0.9rem] tracking-[0.4em] text-white/60 uppercase">
            {post.data.pubDate.toISOString().slice(0, 10)}{post.data.author && ` · ${post.data.author}`}
          </p>
        </div>
      </section>

      <article
        class="md-rich mt-8 rounded-2xl px-8 py-10 sm:px-14 sm:py-14"
        style={{ backgroundColor: theme.paper }}
      >
        {
          post.data.description && (
            <>
              <p class="mb-10 text-lg leading-loose tracking-[0.08em] text-white/70">{post.data.description}</p>
              <div class="mb-10 h-px bg-[rgba(226,222,255,0.25)]"></div>
            </>
          )
        }
        <Content />
      </article>

      <nav class="mt-10 flex flex-wrap justify-between gap-4 sm:flex-nowrap">
        {
          prev ? (
            <a
              class="flex-1 rounded-2xl bg-[rgba(15,12,34,0.35)] px-7 py-5 transition-colors hover:bg-[rgba(196,190,255,0.15)]"
              href={`${routes.article}${prev.id}`}
            >
              <p class="inline-flex items-center gap-2 text-xs tracking-[0.4em] text-white/50 uppercase">
                <ArrowLeft className="h-4 w-4" strokeWidth={1.5} />
                <span>{article.prevLabel}</span>
              </p>
              <p class="mt-2 text-xl tracking-[0.2em]">{prev.data.title}</p>
            </a>
          ) : (
            <span></span>
          )
        }
        {
          next ? (
            <a
              class="flex-1 rounded-2xl bg-[rgba(15,12,34,0.35)] px-7 py-5 text-right transition-colors hover:bg-[rgba(196,190,255,0.15)]"
              href={`${routes.article}${next.id}`}
            >
              <p class="inline-flex items-center gap-2 text-xs tracking-[0.4em] text-white/50 uppercase">
                <span>{article.nextLabel}</span>
                <ArrowRight className="h-4 w-4" strokeWidth={1.5} />
              </p>
              <p class="mt-2 text-xl tracking-[0.2em]">{next.data.title}</p>
            </a>
          ) : (
            <span></span>
          )
        }
      </nav>
    </main>
  </div>
</BaseLayout>
