---
import { extraGroups,  assets, site, layout } from '../../config';
import ListShell from '../list/list-shell.astro';
import { ArrowRight, ArrowUpRight } from 'lucide-react';
import BaseLayout from '../../layouts/base-layout.astro';
import '../../styles/global.css';

const groups = extraGroups.map((group) => ({
  name: group.name,
  en: group.en,
  links: group.links.map((link) => ({ name: link.name, desc: link.desc, url: link.url, external: link.external }))
}));
---

<BaseLayout title={`${site.name} | EXTRA`}>
  <ListShell bgImage={assets.layoutBackgrounds.extra} eyebrow="EXTRA">
    <div class="mx-auto max-w-6xl px-6 pb-24" style={{ paddingTop: layout.listTopPadding }}>
      {
        groups.map((group) => (
          <section class="mt-12 first:mt-0">
            <div class="mb-4 flex items-baseline gap-4">
              <h2 class="text-[1.6rem] tracking-[0.4em]">{group.name}</h2>
              <span class="text-[0.7rem] uppercase tracking-[0.5em] text-white/45">{group.en}</span>
            </div>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
              {group.links.map((link) => (
                <a
                  class="group flex flex-col gap-1.5 rounded-xl bg-[rgba(15,12,34,0.25)] px-5 py-4 transition-colors hover:bg-[rgba(196,190,255,0.12)]"
                  href={link.url}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener' : undefined}
                >
                  <span class="flex items-center justify-between">
                    <span class="text-lg tracking-[0.25em]">{link.name}</span>
                    {link.external ? (
                      <ArrowUpRight
                        className="h-4 w-4 text-white/35 transition-colors group-hover:text-white/85"
                        strokeWidth={1.5}
                      />
                    ) : (
                      <ArrowRight
                        className="h-4 w-4 text-white/35 transition-colors group-hover:text-white/85"
                        strokeWidth={1.5}
                      />
                    )}
                  </span>
                  <span class="text-[0.85rem] leading-7 tracking-[0.08em] text-white/55">{link.desc}</span>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </ListShell>
</BaseLayout>
